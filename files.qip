set_global_assignment -name SYSTEMVERILOG_FILE xerox.sv
set_global_assignment -name SDC_FILE xerox.sdc

# PLL: 96 MHz clk_sys, taken unmodified from the shipped Superman core along
# with rtl/sdram.sv. BOTH OUTPUTS ARE AT PHASE SHIFT 0 and that is deliberate -
# the SDRAM pin clock is generated by an altddio_out cell in xerox.sv, not by a
# phase-shifted PLL output. Superman's BUG-043 describes the abandoned
# phase-shift approach and is stale; following it would reintroduce a shift the
# working design does not have.
#
# outclk_1 is Superman's 48 MHz sound clock and is unused here. Left in place
# rather than regenerated: this PLL is part of a working SDRAM configuration and
# an unused output costs nothing.
set_global_assignment -name QIP_FILE rtl/pll/pll.qip

# Infrastructure
set_global_assignment -name VERILOG_FILE rtl/reset_ctrl.v

# SDRAM controller, from the shipped Superman core - see PLAN.md "Memory
# implementation" for the list of parts that must not be touched, and for the
# surrounding recipe (sys/sys.tcl lines 95-98, the altddio_out clock cell, the
# bidirectional DQ existing only at the top level, SDRAM I/O unconstrained in
# the .sdc).
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sdram.sv

# Video
set_global_assignment -name VERILOG_FILE rtl/xerox_video.v
set_global_assignment -name VERILOG_FILE rtl/xerox_dispram.v
set_global_assignment -name SEARCH_PATH rtl

# The machine (X5): path B's engine - Xerox's own 48-bit microword - and
# everything around it. xerox_cp48.v is SYSTEMVERILOG_FILE because the
# generated xerox_uword48.vh it includes declares localparams at file scope.
# Path A's engine (xerox_cpu.v and its parts) is in archive/rtl/.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/xerox_cp48.v
set_global_assignment -name VERILOG_FILE rtl/xerox_timer8254.v
set_global_assignment -name VERILOG_FILE rtl/picorv32.v
set_global_assignment -name VERILOG_FILE rtl/xerox_iop.v
set_global_assignment -name VERILOG_FILE rtl/xerox_machine.v
set_global_assignment -name VERILOG_FILE rtl/xerox_loader.v
set_global_assignment -name VERILOG_FILE rtl/xerox_sd.v
set_global_assignment -name VERILOG_FILE rtl/xerox_input.v
